# =====================================================================================
# PRODUCTION settings. Copy to ".env" ON THE SERVER and fill in every value.
# Never commit .env or send it by email/chat. The app REFUSES TO START if a required
# value below is missing or unsafe (see production.py).
# =====================================================================================
APP_ENV=production

# Long random value. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Keep it the same across restarts, or everyone is signed out and emailed links stop working.
FLASK_SECRET_KEY=

FLASK_DEBUG=false
COOKIE_SECURE=true
# Your public address, exactly as visitors type it. Used in emailed verification/reset links.
APP_BASE_URL=https://clinic.example.com

# Set true when the app sits behind Nginx / Caddy / Cloudflare / a hosting platform's router.
# REQUIRED in that case: otherwise the login lockout sees every visitor as the same address.
# PROXY_HOPS = how many proxies are in front (1 for just Nginx or Caddy, 2 for Cloudflare + Nginx).
TRUST_PROXY=true
PROXY_HOPS=1

# --- Database: use a dedicated user, NOT root ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hawkeye_database
MYSQL_USER=hawkeye_app
MYSQL_PASSWORD=

# Start the reminder emails. Safe with many workers (database locks make one worker do each job).
ENABLE_SCHEDULER=true

# Minutes after an appointment's start time before an un-attended Pending/Confirmed visit is
# marked Missed (minimum 30). Staff should mark patients Attended when they arrive.
MISSED_GRACE_MINUTES=120

# --- First administrator (only used when the database has no Admin yet) ---
# Set a strong one-time password, sign in, then change it under "Change password".
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO_ACCOUNTS=false

# --- Shown on the Privacy Notice page (CLINIC_CONTACT_EMAIL is required) ---
CLINIC_NAME=HawkEye Optical Clinic
CLINIC_CONTACT_EMAIL=
CLINIC_ADDRESS=

# --- Email (Gmail App Password works for small volume; a transactional provider is better, see DEPLOY.md) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# --- Logging (optional): rotating file, 5 MB x 5 ---
LOG_FILE=logs/hawkeye.log
LOG_LEVEL=INFO

# Optional "Sign in / Sign up with Google" for patients. Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this authorised redirect URI:
#   <APP_BASE_URL>/auth/google/callback      e.g. http://127.0.0.1:5000/auth/google/callback
# Leave both empty to hide the Google buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
