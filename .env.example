# Copy this file to .env and fill in your own local values. Never commit or share .env.
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=false
COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:5000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hawkeye_database
MYSQL_USER=root
MYSQL_PASSWORD=

ENABLE_SCHEDULER=true

# Minutes after an appointment's start time before an un-attended Pending/Confirmed visit is
# marked Missed (minimum 30).
MISSED_GRACE_MINUTES=120

# First-run admin (only used when the database has no Admin yet). If ADMIN_PASSWORD is empty,
# a random password is generated and printed once in the console.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true ONLY on a local demo machine to create the well-known demo accounts from the README.
SEED_DEMO_ACCOUNTS=true

# Optional Gmail SMTP (use a newly generated Google App Password; never reuse a shared one)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ---- Production only (see .env.production.example and DEPLOY.md) ----
# APP_ENV=production, TRUST_PROXY, PROXY_HOPS, CLINIC_CONTACT_EMAIL, CLINIC_NAME, CLINIC_ADDRESS, LOG_FILE, LOG_LEVEL

# Optional "Sign in / Sign up with Google" for patients. Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this authorised redirect URI:
#   <APP_BASE_URL>/auth/google/callback      e.g. http://127.0.0.1:5000/auth/google/callback
# Leave both empty to hide the Google buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
